{
    "compilerOptions": {
        "baseUrl": ".",
        "inlineSourceMap": true,
        "inlineSources": true,
        "module": "ESNext",
        "target": "ESNext",
        "allowJs": true,
        "checkJs": true,
        "noImplicitAny": true,
        "importHelpers": true,
        "lib": ["ESNext", "ES5", "ES6", "ES7"],
        "allowSyntheticDefaultImports": true
    },
    "include": ["esbuild.ts"],
    "exclude": ["src"]
}
