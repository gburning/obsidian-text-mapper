{
    "compilerOptions": {
        "module": "nodenext",
        "target": "ESNext",
        "noImplicitAny": true,
        "importHelpers": true,
        "moduleResolution": "nodenext",
        "lib": ["DOM", "ES5", "ES6", "ES7"],
        "noEmit": true,
        "allowImportingTsExtensions": true
    },
    "include": ["env.d.ts", "src/**/*.ts"]
}
